# ─── Supabase ────────────────────────────────────────────────────────────────
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_anon_key_aqui"
# Service role key: usada SOMENTE no servidor (criar usuários, operações admin).
# Obrigatória para ativar/desativar logins em /pessoas.
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_aqui"

# ─── Sync VIOS (vios-app no servidor) — dual-write para este projeto ─────────
# Configure no .env do vios-app, não necessariamente aqui no Next.js:
# SAMA_SUPABASE_URL="https://SEU-PROJETO-SAMA.supabase.co"
# SAMA_SUPABASE_SERVICE_ROLE_KEY="service_role_do_SAMA"
# VIOS_USER="seu_usuario@vios.com.br"
# VIOS_PASS="sua_senha_vios"

# ─── VIOS API (integração BP — tarefas processuais) ─────────────────────────
# Token JWT fornecido pelo VIOS. Header: Authorization-Vios: Bearer {token}
VIOS_TOKEN=""
# Intervalo mínimo entre syncs de tarefas no SAMA (minutos). Padrão: 240.
# VIOS_SYNC_COOLDOWN_MINUTES="240"

# ─── Fellow (gravações e transcrições de reuniões online) ───────────────────
# URL do workspace: https://{subdomain}.fellow.app (ex.: https://bpplaw-com.fellow.app)
# Chave em User settings → API & MCP connections. Requer Developer API ativo no workspace.
FELLOW_API_URL=""
FELLOW_API_KEY=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Microsoft Graph (Outlook) — app-only (client credentials) ───────────────
# Registre/reaproveite um app no Azure AD (ex.: Legis-app).
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Aliases legados (opcionais — graph.ts aceita estes nomes também):
# SHAREPOINT_CLIENT_ID=""
# SHAREPOINT_CLIENT_SECRET=""

# ─── ECOA: salas (mailboxes resource) ────────────────────────────────────────
# SAMA_SALA_1_EMAIL="SALA01@bpplaw.com.br"
# SAMA_SALA_2_EMAIL="SALA02@bpplaw.com.br"
# SAMA_SALA_BIBLIOTECA_EMAIL="BIBLIOTECA@bpplaw.com.br"
# SAMA_SALA_OUTBACK_EMAIL="OUTBACK@bpplaw.com.br"

# ─── App local de agendamento VIOS (Electron, POST /casos) ───────────────────
# VIOS_AGENDAMENTO_URL="http://127.0.0.1:3920"

# ─── ECOA: lista SharePoint SOLICITAÇÃO DE AGENDAMENTOS ──────────────────────
# SHAREPOINT_SITE_ID=""
# SHAREPOINT_LIST_ID=""
# SHAREPOINT_AGENDAMENTOS_LIST_ID=""
# SHAREPOINT_USERINFO_LIST_ID=""
# Criado por (Author) exige certificado no Legis-app — client-secret é recusado pelo REST:
# SHAREPOINT_CERT_PATH=".local/sharepoint-app.pem"
# SHAREPOINT_CERT_PEM=""
# SHAREPOINT_COL_TITULO="Title"
# SHAREPOINT_COL_DATA="Data_x0020_do_x0020_Agendamento"
# SHAREPOINT_COL_CI="PROCESSO"
# SHAREPOINT_COL_DESCRICAO="DESCRI_x00c7__x00c3_ODOPRAZO"
# SHAREPOINT_COL_DATA_ENVIAR="DATA_x002d_ENVIAR"
# SHAREPOINT_COL_CLIENTE="CLIENTE"
# SHAREPOINT_COL_AREA="_x00c1_REA_x0020__x002f__x0020_E"
# SHAREPOINT_COL_DEPARTAMENTO="DEPARTAMENTO"
# SHAREPOINT_COL_MOTIVO="MOTIVO_x0020__x002f__x0020_OBSER"
# SHAREPOINT_COL_PUBLICACAO="MOTIVO_x0020__x002f__x0020_OBSER"

# ─── Responsum (colaboradores / avatares) ────────────────────────────────────
# RESPONSUM_SUPABASE_URL=""
# RESPONSUM_SERVICE_ROLE_KEY=""
